{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://selfhandler.local/schemas/backup-records-v1.json",
  "title": "SelfHandler Backup Records v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tables"],
  "properties": {
    "schema_version": { "const": 1 },
    "tables": {
      "type": "object",
      "description": "Runtime validation closes keys to the schema-v1 catalog and each table's attribute/reference allowlist.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "attributes", "references"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*:[0-9]{6}$" },
            "attributes": { "type": "object" },
            "references": { "type": "object" }
          }
        }
      }
    }
  }
}
