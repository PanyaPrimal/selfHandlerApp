{
  "name": "selfhandlerapp",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "build:web": "npm --prefix apps/web run build",
    "lint:web": "npm --prefix apps/web run typecheck",
    "test:deployment": "python -m unittest discover -s deployment/tests -p \"test_*.py\" -v",
    "test:production-smoke": "python deployment/tests/production_smoke.py",
    "test:recovery-smoke": "python deployment/tests/recovery_smoke.py",
    "test:e2e": "npm --prefix apps/web run test:e2e",
    "test:e2e:ui": "npm --prefix apps/web run test:e2e:ui",
    "validate:deployment": "npm run test:deployment && npm run test:production-smoke && npm run test:recovery-smoke"
  }
}
